generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  fullName            String
  email               String            @unique
  phoneNumber         String            @unique
  passwordHash        String
  role                UserRole          @default(PATIENT)
  profileImageUrl     String?
  dateOfBirth         DateTime?
  city                String?
  address             String?
  isActive            Boolean           @default(true)
  lastLogin           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  accountLockedUntil  DateTime?
  failedLoginAttempts Int               @default(0)
  isEmailVerified     Boolean           @default(false)
  lastFailedLoginAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  fcmTokens           Json?             @default("[]")
  subscriptionPlan    SubscriptionPlan  @default(FREE)
  auditLogs           AuditLog[]
  caregiverLinks      CaregiverLink[]   @relation("CaregiverTo")
  caregiverEmployers  CaregiverLink[]   @relation("EmployerFrom")
  caregiverProfile    CaregiverProfile?
  emergencies         Emergency[]       @relation("PatientEmergencies")
  medicalProfile      MedicalProfile?
  medicalReports      MedicalReport[]
  notificationLogs    NotificationLog[]
  pushMessages        PushMessage[]
  passwordResets      PasswordReset[]
  refreshTokens       RefreshToken[]
  responder           Responder?
  emailVerification   EmailVerification?
  sentMessages        ChatMessage[]     @relation("MessageSender")
  patientChatRooms    ChatRoom[]        @relation("PatientChatRooms")
  caregiverChatRooms  ChatRoom[]        @relation("CaregiverChatRooms")
  responderChatRooms  ChatRoom[]        @relation("ResponderChatRooms")

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([isActive])
}

model MedicalProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  bloodType          String?
  chronicDiseases    Json?       @default("[]")
  allergies          Json?       @default("[]")
  medications        Json?       @default("[]")
  emergencyContacts  Json?       @default("[]")
  disabilities       Json?       @default("[]")
  medicalHistory     String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  cnic               String?     @unique
  patientType        PatientType @default(NORMAL)
  predefinedMessages Json?       @default("[]")
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaregiverProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  cnic      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Emergency {
  id                   String              @id @default(cuid())
  patientId            String
  emergencyType        String              @default("MEDICAL")
  latitude             Float
  longitude            Float
  accuracy             Float?
  status               EmergencyStatus     @default(ACTIVE)
  voiceAlertGenerated  Boolean             @default(false)
  additionalInfo       String?
  cancellationDeadline DateTime
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  resolvedAt           DateTime?
  voiceSummary         String?
  /// TREATED | TRANSPORTED | FALSE_ALARM | PATIENT_NOT_FOUND (set by the responder on resolve)
  resolutionOutcome    String?
  resolutionNote       String?
  /// Device reported a mock/fake GPS provider when the SOS was raised
  locationMocked       Boolean             @default(false)
  patient              User                @relation("PatientEmergencies", fields: [patientId], references: [id], onDelete: Cascade)
  emergencyRequests    EmergencyRequest[]
  emergencyTracking    EmergencyTracking[]
  medicalReports       MedicalReport[]

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@index([cancellationDeadline])
  @@index([patientId, resolutionOutcome])
}

model Responder {
  id                    String              @id @default(cuid())
  userId                String              @unique
  licenseNumber         String              @unique
  specialization        Json?               @default("[]")
  currentLatitude       Float?
  currentLongitude      Float?
  isAvailable           Boolean             @default(true)
  averageResponseTime   Int?
  totalResponsesHandled Int                 @default(0)
  rating                Float               @default(5.0)
  totalRatings          Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  cnic                  String?             @unique
  isVerified            Boolean             @default(false)
  organization          String?
  responderType         ResponderType       @default(FIRST_RESPONDER)
  vehicleType           String?               @default("MOTORBIKE_AMBULANCE")
  motorbikeNumber       String?
  drivingLicenseUrl     String?
  motorbikeDocUrl       String?
  cnicImageUrl          String?
  cnicBackImageUrl      String?
  employeeCardImageUrl  String?
  employeeCardBackImageUrl String?
  rejectionReason       String?
  verificationStatus    VerificationStatus  @default(PENDING)
  emergencyRequests     EmergencyRequest[]
  emergencyTracking     EmergencyTracking[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isAvailable])
  @@index([currentLatitude, currentLongitude])
  @@index([createdAt])
}

model EmergencyRequest {
  id                      String                 @id @default(cuid())
  emergencyId             String
  responderId             String
  status                  EmergencyRequestStatus @default(PENDING)
  distanceKm              Float?
  estimatedArrivalMinutes Int?
  sentAt                  DateTime               @default(now())
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  patientRating           Int?
  ratedAt                 DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  emergency               Emergency              @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  responder               Responder              @relation(fields: [responderId], references: [userId], onDelete: Cascade)

  @@unique([emergencyId, responderId])
  @@index([emergencyId])
  @@index([responderId])
  @@index([status])
  @@index([sentAt])
}

model EmergencyTracking {
  id          String         @id @default(cuid())
  emergencyId String
  responderId String
  latitude    Float
  longitude   Float
  accuracy    Float?
  status      TrackingStatus @default(EN_ROUTE)
  timestamp   DateTime       @default(now())
  createdAt   DateTime       @default(now())
  emergency   Emergency      @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  responder   Responder      @relation(fields: [responderId], references: [userId], onDelete: Cascade)

  @@index([emergencyId])
  @@index([responderId])
  @@index([status])
  @@index([timestamp])
}

model CaregiverLink {
  id           String           @id @default(cuid())
  caregiverId  String
  patientId    String
  relationship String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  status       InvitationStatus @default(PENDING)
  requesterId  String?
  caregiver    User             @relation("CaregiverTo", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient      User             @relation("EmployerFrom", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, patientId])
  @@index([caregiverId])
  @@index([patientId])
}

model MedicalReport {
  id            String            @id @default(cuid())
  emergencyId   String?
  userId        String?
  reportType    MedicalReportType
  fileName      String
  fileUrl       String
  fileSizeBytes Int
  uploadedAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())
  emergency     Emergency?        @relation(fields: [emergencyId], references: [id])
  uploadedBy    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emergencyId])
  @@index([userId])
  @@index([reportType])
  @@index([uploadedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model NotificationLog {
  id             String    @id @default(cuid())
  userId         String
  type           String
  channels       Json
  title          String
  body           String
  status         String
  isRead         Boolean   @default(false)
  deliveredAt    DateTime?
  failureReason  String?
  createdAt      DateTime  @default(now())
  /// Set only for admin-initiated broadcasts. Stores the admin's userId.
  sentByAdminId  String?
  /// Human-readable target for admin broadcasts: "ALL", "PATIENT", "RESPONDER",
  /// "CAREGIVER", or "individual:<email>" for single-user sends.
  recipientGroup String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentByAdminId])
  @@index([createdAt])
  @@index([status])
  @@index([isRead])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model ChatRoom {
  id           String       @id @default(cuid())
  roomType     ChatRoomType @default(CAREGIVER_PATIENT)
  patientId    String
  caregiverId  String?
  responderId  String?
  emergencyId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  messages     ChatMessage[]
  patient      User         @relation("PatientChatRooms",   fields: [patientId],   references: [id], onDelete: Cascade)
  caregiver    User?        @relation("CaregiverChatRooms", fields: [caregiverId], references: [id], onDelete: Cascade)
  responder    User?        @relation("ResponderChatRooms", fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([patientId, caregiverId])
  @@unique([patientId, responderId, emergencyId])
  @@index([patientId])
  @@index([caregiverId])
  @@index([responderId])
  @@index([emergencyId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  roomId     String
  senderId   String
  content    String
  messageType MessageType @default(TEXT)
  mediaUrl   String?
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  room       ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender     User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VOICE_ALERT
  DOCUMENT
}

enum ChatRoomType {
  CAREGIVER_PATIENT
  EMERGENCY_RESPONDER
}

enum UserRole {
  PATIENT
  RESPONDER
  CAREGIVER
  ADMIN
}

enum PatientType {
  NORMAL
  DEAF
}

enum ResponderType {
  PARAMEDIC
  RESCUE_OFFICER
  EMT
  FIRST_RESPONDER
  VOLUNTEER
  AMBULANCE
  DOCTOR
  EMERGENCY_RESPONDER
}

enum EmergencyStatus {
  ACTIVE
  RESOLVED
  CANCELLED
  ASSIGNED
  ARRIVED
  COMPLETED
}

enum EmergencyRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum TrackingStatus {
  EN_ROUTE
  ARRIVED
  TREATING
  TRANSPORTED
}

enum MedicalReportType {
  LAB
  IMAGING
  PRESCRIPTION
  DISCHARGE_SUMMARY
  VITAL_SIGNS
  OTHER
}

enum SubscriptionPlan {
  FREE
  PROFESSIONAL
  EXECUTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Self-hosted push delivery queue (store-and-forward, replaces Firebase FCM)
model PushMessage {
  id                String    @id @default(cuid())
  userId            String
  notificationLogId String?
  type              String
  title             String
  body              String
  data              Json      @default("{}")
  priority          String    @default("normal")
  /// QUEUED | SENT | DELIVERED | EXPIRED
  status            String    @default("QUEUED")
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  expiresAt         DateTime
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, sentAt])
  @@index([expiresAt])
}

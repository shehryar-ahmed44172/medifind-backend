# MediFind backend configuration.
# Copy to .env for local development. Never commit the filled-in file.
# On a host (Render, Koyeb, Fly) set these as environment variables instead.

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/medifind
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ─── Authentication ──────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
RESET_TOKEN_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=30d

# ─── Links in outgoing email ─────────────────────────────────────────────
# Where a password-reset or verification link should land.
APP_URL=http://localhost:3100
MOBILE_APP_ORIGIN=

# ─── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Google Gemini (symptom suggestions, deaf quick replies) ─────────────
GEMINI_API_KEY=
# Optional: comma-separated fallback list
GEMINI_MODELS=

# ─── Stripe (subscriptions) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── WebRTC TURN relay (voice and video calls behind NAT) ────────────────
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Emergency behaviour ─────────────────────────────────────────────────
# Seconds a patient has to cancel before responders are alerted.
EMERGENCY_CANCELLATION_WINDOW_SECONDS=60
SOS_HOURLY_LIMIT=5
FALSE_ALARM_REVIEW_THRESHOLD=3

# ─── Real-time ───────────────────────────────────────────────────────────
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=20000

# ─── Seed data ───────────────────────────────────────────────────────────
# Password given to the accounts created by the demo seed script.
DEMO_PASSWORD=

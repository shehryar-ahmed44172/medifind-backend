# MediFind backend configuration.
# Copy to .env for local development. Never commit the filled-in file.
# On a host (Render, Koyeb, Fly) set these as environment variables instead.

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/medifind
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ─── Authentication ──────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
RESET_TOKEN_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=30d

# ─── Links in outgoing email ─────────────────────────────────────────────
# Where a password-reset link should land (the web portal). FRONTEND_URL wins
# over APP_URL; APP_URL is kept for older setups.
FRONTEND_URL=
APP_URL=http://localhost:3100
MOBILE_APP_ORIGIN=

# ─── Browser origins allowed to call the API (CORS) ──────────────────────
# Comma-separated, e.g. https://medifind.clientorahq.com,https://medifind-portal.vercel.app
# Empty = every origin (local development). The mobile app is not affected.
CORS_ORIGINS=

# ─── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Hosts that block SMTP (Render free) send over HTTPS instead when one is set:
# BREVO_API_KEY (+ optional BREVO_SENDER_EMAIL, a sender verified in Brevo), or
# RESEND_API_KEY (+ RESEND_FROM on a domain verified in Resend).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=
RESEND_FROM=

# ─── Uploads in Cloudflare R2 (optional) ─────────────────────────────────
# Leave empty to keep uploads on the local disk only (local development).
# On a host without a persistent disk (Render free) set all four: every upload
# is also stored in the bucket and is fetched back after a restart.
# R2_ENDPOINT is optional and overrides https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ─── Google Gemini (symptom suggestions, deaf quick replies) ─────────────
GEMINI_API_KEY=
# Optional: comma-separated fallback list
GEMINI_MODELS=

# ─── Stripe (subscriptions) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── WebRTC TURN relay (voice and video calls behind NAT) ────────────────
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Emergency behaviour ─────────────────────────────────────────────────
# Seconds a patient has to cancel before responders are alerted.
EMERGENCY_CANCELLATION_WINDOW_SECONDS=60
SOS_HOURLY_LIMIT=5
FALSE_ALARM_REVIEW_THRESHOLD=3

# ─── Real-time ───────────────────────────────────────────────────────────
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=20000

# ─── Seed data ───────────────────────────────────────────────────────────
# Password given to the accounts created by the demo seed script.
DEMO_PASSWORD=

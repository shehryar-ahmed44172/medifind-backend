{
  "info": {
    "_postman_id": "medifind-backend-api",
    "name": "MediFind Backend API - Week 1",
    "description": "Complete API testing collection for MediFind Authentication Module\n\nEndpoints: Register, Login, Refresh Token, Logout, Get Profile\n\nQuick Start:\n1. Import this collection into Postman\n2. Create environment variable: baseUrl = http://localhost:3000\n3. Start server: npm run dev\n4. Test endpoints in order (Register → Login → Get Profile → Logout)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Server Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has status field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('Server is running', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.uptime).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if backend server is running and healthy"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('User ID is generated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.exist;",
                  "    pm.environment.set('userId', jsonData.data.id);",
                  "});",
                  "",
                  "pm.test('Email matches request', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.email).to.eql('john.doe@medifind.com');",
                  "});",
                  "",
                  "pm.test('Role is PATIENT', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.role).to.eql('PATIENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@medifind.com\",\n  \"phoneNumber\": \"+1-234-567-8900\",\n  \"password\": \"SecurePassword123!\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user account\n\nRequired fields:\n- fullName: Full name of user\n- email: Valid email address (unique)\n- phoneNumber: Phone number with country code\n- password: Min 8 characters\n- role: PATIENT, RESPONDER, CAREGIVER, or ADMIN"
          },
          "response": []
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Access token generated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.accessToken).to.exist;",
                  "    pm.expect(jsonData.data.accessToken.length).to.be.greaterThan(0);",
                  "    pm.environment.set('accessToken', jsonData.data.accessToken);",
                  "});",
                  "",
                  "pm.test('Refresh token generated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.refreshToken).to.exist;",
                  "    pm.expect(jsonData.data.refreshToken.length).to.be.greaterThan(0);",
                  "    pm.environment.set('refreshToken', jsonData.data.refreshToken);",
                  "});",
                  "",
                  "pm.test('Token expires in 24 hours', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.expiresIn).to.eql(86400);",
                  "});",
                  "",
                  "pm.test('User data in response', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user.email).to.eql('john.doe@medifind.com');",
                  "    pm.expect(jsonData.data.user.role).to.eql('PATIENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@medifind.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login user and receive access + refresh tokens\n\nReturns:\n- accessToken: Use for API requests (24h expiry)\n- refreshToken: Use to get new accessToken (30d expiry)\n- expiresIn: Token expiry in seconds (86400 = 24 hours)"
          },
          "response": []
        },
        {
          "name": "3. Get User Profile (Protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('User profile returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.userId).to.exist;",
                  "    pm.expect(jsonData.data.email).to.eql('john.doe@medifind.com');",
                  "    pm.expect(jsonData.data.role).to.eql('PATIENT');",
                  "});",
                  "",
                  "pm.test('No password in response', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.password).to.not.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Get current logged-in user profile\n\nRequires Authorization header with accessToken\n\nResponse includes:\n- userId: User unique identifier\n- email: User email\n- role: User role (PATIENT, RESPONDER, CAREGIVER, ADMIN)"
          },
          "response": []
        },
        {
          "name": "4. Refresh Access Token ⭐ CRITICAL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('New access token generated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.accessToken).to.exist;",
                  "    var newToken = jsonData.data.accessToken;",
                  "    var oldToken = pm.environment.get('accessToken');",
                  "    pm.expect(newToken).to.not.eql(oldToken);",
                  "    pm.environment.set('accessToken', newToken);",
                  "});",
                  "",
                  "pm.test('Token expires in 24 hours', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.expiresIn).to.eql(86400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ]
            },
            "description": "Get new access token using refresh token\n\n⭐ CRITICAL for mobile apps - call when access token expires\n\nUse to:\n- Keep user session alive without re-login\n- Get new access token after 24h expiry\n- Maintain long-running sessions (30 days)\n\nRefresh token remains valid until:\n- User logs out\n- 30 days pass"
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Logout message displayed', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('Logout successful');",
                  "});",
                  "",
                  "pm.test('Clear tokens from environment', function () {",
                  "    pm.environment.unset('accessToken');",
                  "    pm.environment.unset('refreshToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Logout and revoke refresh token\n\nAfter logout:\n- Refresh token is invalidated\n- Cannot use token to login again\n- Must login fresh to get new tokens"
          },
          "response": []
        }
      ]
    },
